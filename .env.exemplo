NODE_ENV=development
LOG_NIVEL=debug

# A API usa os dois papeis restritos, que a RLS alcanca. `agendamento_gestor`
# precisa de senha definida uma vez: veja o CLAUDE.md.
BANCO_URL=postgres://agendamento_gestor:agendamento@localhost:5432/agendamento
BANCO_URL_PUBLICO=postgres://agendamento_publico:agendamento@localhost:5432/agendamento

# O DONO do banco, e nao um dos papeis: migracao, semente e provisionamento
# escrevem em `estabelecimentos`, que nao tem politica de insercao de proposito.
DIRETO_BANCO_URL=postgres://agendamento:agendamento@localhost:5432/agendamento

SESSAO_SEGREDO=troque-este-valor-por-um-segredo-de-32-caracteres

APP_URL=http://localhost:5173
API_URL=http://localhost:3000
AUTH_URL=http://localhost:3000/auth
PUBLICO_DOMINIO_BASE=localhost:3001

EMAIL_PROVEDOR=SMTP
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORTA=1025
EMAIL_REMETENTE=nao-responda@agendamento.local

OTP_CANAL=LOG

ARMAZENAMENTO_TIPO=DISCO
ARMAZENAMENTO_DIRETORIO=./.dados/armazenamento
